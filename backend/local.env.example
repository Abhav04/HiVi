# Copy to backend/local.env — paste REAL values from Render → Web Service → Environment
# Do NOT leave the example placeholders below; Google will return "Error 401: invalid_client".
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# → your client → Authorized redirect URIs — ADD BOTH (exact match):
#   http://localhost:8080/login/oauth2/code/google
#   https://hivi-idam.onrender.com/login/oauth2/code/google
# GitHub OAuth App → Authorization callback URL:
#   http://localhost:8080/login/oauth2/code/github
#
# GOOGLE_CLIENT_ID must end with: .apps.googleusercontent.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
